# Save a copy as .env.docker. Never commit the real file.
# Set a strong password and a cryptographically random JWT secret (32+ characters).
DB_PASSWORD=
JWT_SECRET=

# Windows website port; database is published separately on 127.0.0.1:5433.
FRONTEND_PORT=5000
# Leave blank to derive from FRONTEND_PORT, or set a public URL when hosting.
APP_BASE_URL=
# Leave blank for local defaults; set exact allowed browser origins for hosting.
CORS_ORIGIN=

# Optional AI, saved chat history, and email delivery.
GEMINI_API_KEY=
GROQ_API_KEY=
MONGODB_URI=
MONGODB_DB_NAME=gymverse_chat
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=GymVerse <no-reply@gymverse.local>
