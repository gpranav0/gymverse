# Server
PORT=5000
NODE_ENV=development

# Swagger is served at /api-docs. It is on automatically outside production; set this to
# 'true' to expose it in production as well (it documents every route, so think first).
ENABLE_API_DOCS=false

# Set to 'true' ONLY when a reverse proxy sits in front of this server. It makes
# Express trust X-Forwarded-For; on a directly-reachable server any client can forge
# that header and get a fresh rate-limit bucket per request.
TRUST_PROXY=false

# Comma-separated list of browser origins allowed to call this API.
# Use * only for local experimentation, never in production.
# In development, localhost and 127.0.0.1 are treated as aliases on the same port.
CORS_ORIGIN=http://localhost:5173

# Single-process mode: serve the built frontend from this server, so the SPA and the API
# share one origin. Path relative to gymverse-backend. Leave blank when the frontend is
# served separately (for example by the Vite dev server).
SERVE_FRONTEND_DIST=

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gymverse
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_POOL_MAX=10

# Owner-level credentials for migrate.js, reset_db.js, verify_stack.js and backup_db.js.
# Leave blank to use DB_USER / DB_PASSWORD. Set them when the API runs as a
# least-privilege role that cannot change the schema.
MIGRATION_DB_USER=
MIGRATION_DB_PASSWORD=

# Auth — required. The server refuses to start without JWT_SECRET.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=1d

# Password-reset and email-confirmation requests allowed per IP per 15 minutes.
RECOVERY_RATE_LIMIT=5

# 'true' refuses sign-in until the account's email address is confirmed. Needs SMTP below,
# otherwise nobody can confirm (the server refuses to start in production without it).
REQUIRE_EMAIL_VERIFICATION=false

# Public URL of the frontend, used to build the links in emails.
APP_BASE_URL=http://localhost:5173

# Email (optional). Without SMTP_HOST, development writes each email to
# gymverse-backend/.mail-outbox/ instead of sending it; production logs that mail is off.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=GymVerse <no-reply@gymverse.local>

# AI assistant (optional). Gemini is tried first, Groq is the fallback.
# Leave a key EMPTY to disable that provider. A placeholder like 'your_groq_api_key'
# is a truthy value, so the provider is treated as configured and every failover
# burns the full AI_TIMEOUT_MS on a call that cannot succeed.
# The /api/chat endpoint requires a logged-in user and is rate limited per account,
# because every call spends money on these keys.
# Model IDs get retired periodically — override here rather than editing code.
GEMINI_API_KEY=
# Gemini models are tried in order. Each has its own free-tier quota (about 20 requests a
# day) and its own capacity, so when one answers 429 (quota), 503 (overloaded) or 404
# (retired) the next is tried. GEMINI_MODEL, if set, goes to the front of the list.
GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-flash-lite-latest
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Milliseconds to wait on one model before trying the next, and for the whole reply.
AI_TIMEOUT_MS=15000
AI_TOTAL_TIMEOUT_MS=40000

# Chat history (optional) — MongoDB Atlas stores ONLY chat conversations and messages.
# Users, roles, memberships, payments, attendance, workouts and classes stay in PostgreSQL.
#
# Leave MONGODB_URI blank to run in temporary-chat mode: the assistant still works, the
# widget shows "Temporary chat — history isn't being saved", and nothing is persisted.
#
# Atlas: Database > Connect > Drivers gives a string of the form
#   mongodb+srv://<db_user>:<url_encoded_password>@<cluster-host>/?retryWrites=true&w=majority
# URL-encode special characters in the password. Never commit the real value.
#
# If the backend logs "connecting..." but never "connected", and `node verify_mongo.js`
# fails, Node's DNS resolver may be unable to look up SRV records (seen on Windows when
# Node resolves via 127.0.0.1). Use the standard form instead — Atlas lists it under
# Connect > Drivers > older driver versions:
#   mongodb://<db_user>:<password>@<host-00>:27017,<host-01>:27017,<host-02>:27017/?tls=true&authSource=admin&replicaSet=<replica-set>
#
# If DNS works but the connection fails with "tlsv1 alert internal error" (SSL alert 80),
# Atlas is refusing this machine's IP address. Add it under Atlas > Network Access. Home
# and mobile connections change IP, so this recurs until the current address is allowed.
MONGODB_URI=
MONGODB_DB_NAME=gymverse_chat
# Absolute path to mongosh, used only by `node verify_mongo.js` (never by the API).
MONGOSH_PATH=

# Housekeeping job: expires lapsed subscriptions, closes forgotten check-ins and purges
# spent tokens. Runs at startup and then on this interval.
MAINTENANCE_ENABLED=true
MAINTENANCE_INTERVAL_MINUTES=60

# Backups (npm run backup). PG_DUMP_PATH is needed when pg_dump is not on PATH, e.g.
# C:\Program Files\PostgreSQL\18\bin\pg_dump.exe on Windows.
BACKUP_DIR=backups
BACKUP_KEEP=14
PG_DUMP_PATH=
