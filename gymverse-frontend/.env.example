# Copy to .env.development for `npm run dev`.
#
# Leave VITE_API_URL unset for production builds (`npm run build`): the app then calls
# /api on the same origin it is served from. Do not put this in a plain `.env` file —
# Vite loads `.env` for every mode, so a localhost URL would be baked into production.
VITE_API_URL=http://localhost:5000/api
